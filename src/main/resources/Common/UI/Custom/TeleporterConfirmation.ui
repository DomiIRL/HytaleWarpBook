$C = "../Common.ui";

$C.@PageOverlay {
  LayoutMode: Middle;

  $C.@DecoratedContainer {
    Anchor: (Width: 400, Height: 200);

    #Title {
      $C.@Title {
        @Text = "Set Destination";
      }
    }

    #Content {
        Padding: (Full: 16);
        LayoutMode: Top;
        FlexWeight: 1;

        Group {
            FlexWeight: 1;
            LayoutMode: Top;

            Label {
                Text: "Are you sure you want to set this destination?";
                Style: (...$C.@DefaultLabelStyle, TextAlignment: 4);
                Anchor: (Width: 1, Horizontal: 4);
            }
            Label {
                Text: "The warp page will be consumed.";
                Style: (...$C.@DefaultLabelStyle, TextColor: #aaaaaa, TextAlignment: 4);
                Anchor: (Width: 1, Horizontal: 4);
                Margin: (Top: 5);
            }
        }

        Group {
            LayoutMode: Left;
            LayoutSpacing: 20;
            Anchor: (Horizontal: 4);

            $C.@TextButton #ConfirmButton {
                @Text = "Confirm";
                Anchor: (Width: 120, Height: 40);
            }

            $C.@TextButton #CancelButton {
                @Text = "Cancel";
                Anchor: (Width: 120, Height: 40);
            }
        }
    }
  }
}

$C.@BackButton {}

