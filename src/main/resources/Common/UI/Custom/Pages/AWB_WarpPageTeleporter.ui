$C = "../Common.ui";

$C.@PageOverlay {
  LayoutMode: Middle;

  $C.@DecoratedContainer {
    Anchor: (Width: 500);

    #Title {
      $C.@Title {
        @Text = %awb.customUI.warpPageTeleporter.title;
      }
    }

    #Content {

      Group #TopPart {
        LayoutMode: Top;
        Padding: (Full: 24);
        Label #UsageTitle {
          Text: %awb.customUI.warpPageTeleporter.useTitle;
          Style: (FontSize: 18, RenderBold: true, RenderUppercase: true, TextColor: #863dfc, HorizontalAlignment: Center);
        }

        Group {
          Background: (TexturePath: "AWB_TopDivider.png");
          Anchor: (Width: 369, Height: 7);
        }

        Label #UsageLabel {
          Text: %awb.customUI.warpPageTeleporter.useLabel;
          Padding: (Top: 12, Horizontal: 10);
          Style: (...$C.@DefaultLabelStyle, Wrap: true, HorizontalAlignment: Center);
        }
      }

      Group #Summon {
        LayoutMode: MiddleCenter;
        Anchor: (Height: 126);
        Background: (TexturePath: "AWB_BindButtonBackground.png");

        Group {
          LayoutMode: Top;

          Label {
            Text: %awb.customUI.warpPageTeleporter.consumesPage;
            Style: (FontSize: 12, TextColor: #afafafff, RenderItalics: true, HorizontalAlignment: Center);
          }

          $C.@TextButton #BindButton {
            @Anchor = (Top: 8, MinWidth: 250, Bottom: 0);
            @Text = %awb.customUI.warpPageTeleporter.bind;
          }
        }
      }
    }
  }
}

$C.@BackButton {}
