$C = "../Common.ui";

$C.@PageOverlay {}

$C.@DecoratedContainer {
  Anchor: (Width: 500, Height: 320);

  #Title {
    Group {
      $C.@Title {
        @Text = %awb.customUI.warpPage.title;
      }

    }
  }

  #Content {
    LayoutMode: Top;
    FlexWeight: 1;

    Group {
      LayoutMode: Top;
      FlexWeight: 1;

      Group #NameGroup {
        LayoutMode: Top;

        Label {
          Text: %awb.customUI.warpPage.enterName;
          Style: (FontSize: 16, TextColor: #ffffff);
        }

        $C.@TextField #Name {
          Style: (FontSize: 18, TextColor: #ffffff);
        }
      }

      Group #TypeGroup {
        LayoutMode: Top;
        Anchor: (Top: 10);

        Label {
          Style: (FontSize: 16, TextColor: #ffffff);
          Text: %awb.customUI.warpPage.type;
        }

        $C.@DropdownBox #BindType {
          Anchor: (Height: 35, Horizontal: 1);
        }
      }

      Group #TargetGroup {
        LayoutMode: Top;
        Anchor: (Top: 10);
        Visible: false;

        Label {
          Style: (FontSize: 16, TextColor: #ffffff);
          Text: %awb.customUI.warpPage.target;
        }

        $C.@DropdownBox #BindTarget {
          Anchor: (Height: 35, Horizontal: 1);
        }
      }
    }

    $C.@TextButton #BindButton {
      @Text = %awb.customUI.warpPage.bind;
      Anchor: (Width: 150, Height: 40, Horizontal: 1);
    }
  }
}

$C.@BackButton {}
